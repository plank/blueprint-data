{
    "name": "plank/blueprint-data",
    "description": "Blueprint addon that generates spatie/laravel-data Data classes (DTOs) for every model in your draft file.",
    "keywords": [
        "plank",
        "laravel",
        "blueprint",
        "laravel-data",
        "dto"
    ],
    "homepage": "https://github.com/plank/blueprint-data",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.3",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "laravel-shift/blueprint": "^2.13",
        "spatie/laravel-data": "^4.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0 || ^10.0",
        "pestphp/pest": "^3.0 || ^4.0"
    },
    "autoload": {
        "psr-4": {
            "Plank\\BlueprintData\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Plank\\BlueprintData\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Plank\\BlueprintData\\BlueprintDataServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
